{
  "name": "selvedge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:companion": "node scripts/build-companion.mjs",
    "build": "npm run build:client && npm run build:companion && npm run build:server",
    "start": "node dist-server/server/db/migrate.js && node dist-server/server/index.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:seed": "tsx src/server/db/seed.ts",
    "db:seed:demo": "tsx src/server/db/seedDemo.ts",
    "demo:login": "tsx src/server/demo/accessCli.ts",
    "evals": "tsx evals/run.ts",
    "companion": "tsx src/cli/index.ts",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "shoot:og": "tsx scripts/shoot-og.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@aws-sdk/client-s3": "^3.1118.0",
    "@aws-sdk/s3-request-presigner": "^3.1118.0",
    "@blaxel/core": "^0.3.21",
    "@clerk/clerk-react": "^5.61.9",
    "@clerk/express": "^2.1.43",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@octokit/auth-app": "^8.2.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "fflate": "^0.8.3",
    "http-proxy": "^1.18.1",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "octokit": "^4.0.2",
    "openai": "^7.4.0",
    "playwright": "^1.61.1",
    "postgres": "^3.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "stripe": "^22.5.0",
    "ulid": "^2.3.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.15",
    "@types/express": "^4.17.21",
    "@types/http-proxy": "^1.17.17",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.28",
    "postject": "^1.0.0-alpha.6",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "esbuild": "$esbuild"
  },
  "bin": {
    "selvedge": "dist-server/cli/index.js"
  }
}
