# Selvedge configuration — copy to .env and fill in.
#
# NEVER commit a filled-in .env. Secrets belong here (deploy-time) or in the
# encrypted vault via the connect UI (per-org model keys and host tokens).
# The server validates this at boot and refuses to start if a REQUIRED value
# is missing; every other feature simply stays off until you set it.

# ── Required to boot ────────────────────────────────────────────────────────
# The only value the app truly can't start without.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ── Credential vault: encrypts every stored model key and host token ─────────
# NOT required to boot — the app runs and watches without it; only connecting a
# key or token fails until it's set. Set it before anyone connects a credential.
CREDENTIALS_KEY=            # a long random string (>= 32 chars); rotating it invalidates the vault

# ── Sign-in (the /api is 503 until these are set) ───────────────────────────
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=  # same publishable key, needed at client build time

# ── Platform voice: a fallback model key for orgs that haven't brought their ─
# own. Optional — customers connect their own key in-app (BYO fuel).
ANTHROPIC_API_KEY=

# ── GitHub App: watch repos, receive code/build events ──────────────────────
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ── GitHub OAuth: the in-app repo setup flow (borrow-and-return migrations) ──
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=

# ── "Login with Railway": one click instead of a token to hunt for. Register a
# Railway OAuth app whose redirect matches _REDIRECT_URI exactly. Without these,
# the Connections page still accepts a pasted Railway token — but a pasted token
# cannot renew itself, whereas the OAuth token set refreshes on its own.
RAILWAY_OAUTH_CLIENT_ID=
RAILWAY_OAUTH_CLIENT_SECRET=
RAILWAY_OAUTH_REDIRECT_URI=   # e.g. https://tryselvedge.com/railway/callback

# ── Databases at go-live: creates one for an app whose .env.example declares a
# DATABASE_URL. Without it, "put it online" says plainly that it can't.
NEON_API_KEY=

# ── Push notifications (Apple). Without these, alerts still fold into the brief ─
APNS_AUTH_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=

# ── The build engine: somewhere for an approved change to actually be made. ──
# An approved card runs in a throwaway Daytona sandbox, the change is pushed to
# a `selvedge/<card>` review branch (never auto-deployed to production).
#
# ONLY THE MACHINES ARE THE DEPLOYMENT'S. Which account an agent runs on is a
# per-org question (server/build/builderAuth.ts): each workspace connects its
# own Anthropic key or Claude subscription, exactly as it connects its own
# OpenAI key. The two variables below are FALLBACKS for orgs that haven't, not
# requirements — the engine is on as soon as DAYTONA_API_KEY is set.
DAYTONA_API_KEY=              # the sandbox provider — the only one required
CLAUDE_CODE_OAUTH_TOKEN=      # optional: covers orgs with no connected Anthropic account (claude setup-token)
MANAGED_FUEL=                 # set to `off` to stop covering anybody — every org then brings its own
GITHUB_TOKEN=                 # clones the repo and pushes the review branch

# Where "create a new repo for this project" puts the repo. Set to a GitHub
# org name (the token needs repo + write:org there); unset, new repos land
# under the token's own user account.
GITHUB_ORG=

# ── The independent grader: judges "did it do what was asked" on a DIFFERENT ─
# provider than authored the change, so a verdict never grades its own work.
# The key is the switch: set it and every finished card's acceptance is graded
# from the actual diff; leave it unset and verdicts honestly top out at
# `probably` — never a false "verified". Grading runs on its own daily budget
# (GRADE_DAILY_BUDGET_USD), so it can never starve the morning brief.
# Two jobs, one key: the independent grader, and Codex as the Inbox's second
# builder (it runs in the same sandbox as Claude Code). Without it, verdicts
# top out at "probably" and the agent switcher says Codex isn't switched on.
OPENAI_API_KEY=
EVAL_MODEL=                # default: gpt-5.6-luna — a grade costs a fraction of a cent
CODEX_MODEL=               # default: gpt-5.6-terra — what Codex runs as, and how its turns are priced
CHAT_MODEL=                # default: claude-sonnet-5 — a general thread on Anthropic fuel
CHAT_MODEL_OPENAI=         # default: gpt-5.6-terra — a general thread on OpenAI fuel
THINKING_DAILY_BUDGET_USD= # default: per plan — chat's own cap, so thinking can never starve the brief

# ── Optional tuning (safe defaults) ─────────────────────────────────────────
PORT=3000
NODE_ENV=production
DAILY_LLM_BUDGET_USD=
NARRATE_MODEL=claude-sonnet-5
COMPOSE_MODEL=claude-fable-5
AGENT_MODEL=               # the model the build agent AUTHORS with (default: sonnet)
SEED_ORG_ID=

# ── Preview proxy: kills Daytona's "Preview URL Warning" interstitial ────────
# A wildcard subdomain (e.g. preview.tryselvedge.com with *.preview… pointed at
# this service). When set, workshop previews are served from
# https://<slug>.<PREVIEW_DOMAIN>/ and the server injects the skip-warning
# header upstream. Unset → direct signed Daytona URLs, warning included.
PREVIEW_DOMAIN=

# --- Billing (Stripe) ---
# Absent on a deployment that doesn't take money: checkout and the portal
# answer 503, the webhook asks Stripe to retry, and every account reads as
# Free. Nothing else changes.
STRIPE_SECRET_KEY=
# Signs every webhook delivery. Without it the webhook door refuses everything,
# which is the correct failure: the signature is the only authentication that
# route has.
STRIPE_WEBHOOK_SECRET=
# The two Pro prices, created in the Stripe dashboard. The interval is read
# back FROM these ids, so an id that matches neither leaves the interval
# unknown rather than guessed.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Flip to true to stop grandfathering new subscriptions at the founding-member
# price. Read only at the moment of buying, so flipping it never reaches back
# and takes a price off somebody who already has it.
PRICING_V2_ENABLED=false
# Where Stripe sends the browser back to after checkout or the portal.
APP_URL=
