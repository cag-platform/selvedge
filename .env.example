# Selvedge configuration — copy to .env and fill in.
#
# NEVER commit a filled-in .env. Secrets belong here (deploy-time) or in the
# encrypted vault via the connect UI (per-org model keys and host tokens).
# The server validates this at boot and refuses to start if a REQUIRED value
# is missing; every other feature simply stays off until you set it.

# ── Required to boot ────────────────────────────────────────────────────────
# The only value the app truly can't start without.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ── Credential vault: encrypts every stored model key and host token ─────────
# NOT required to boot — the app runs and watches without it; only connecting a
# key or token fails until it's set. Set it before anyone connects a credential.
CREDENTIALS_KEY=            # a long random string (>= 32 chars); rotating it invalidates the vault

# ── Sign-in (the /api is 503 until these are set) ───────────────────────────
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=  # same publishable key, needed at client build time

# ── Platform voice: a fallback model key for orgs that haven't brought their ─
# own. Optional — customers connect their own key in-app (BYO fuel).
ANTHROPIC_API_KEY=

# ── GitHub App: watch repos, receive code/build events ──────────────────────
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ── GitHub OAuth: the in-app repo setup flow (borrow-and-return migrations) ──
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=

# ── Push notifications (Apple). Without these, alerts still fold into the brief ─
APNS_AUTH_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=

# ── The build engine: the agent + sandbox that actually makes an approved ────
# change. All three are required to turn it on. Ported from Toile. An approved
# card runs in a throwaway Daytona sandbox, the change is pushed to a
# `selvedge/<card>` review branch (never auto-deployed to production).
DAYTONA_API_KEY=              # the sandbox provider
CLAUDE_CODE_OAUTH_TOKEN=      # the Claude Code agent's auth (claude setup-token)
GITHUB_TOKEN=                 # clones the repo and pushes the review branch

# Where "create a new repo for this project" puts the repo. Set to a GitHub
# org name (the token needs repo + write:org there); unset, new repos land
# under the token's own user account.
GITHUB_ORG=

# ── The evaluating model: judges "did it do what was asked" on a DIFFERENT ───
# model than authored the change, so it never grades its own work.
#
# NOT YET WIRED TO A GRADER. Setting this today changes nothing — the acceptance
# check returns "could not run" and no change can reach the `verified` verdict
# (it tops out at `probably`). Until this is connected, that is the honest
# ceiling rather than a silent pass.
EVAL_MODEL=                # a capable model id, distinct from NARRATE_MODEL

# ── Optional tuning (safe defaults) ─────────────────────────────────────────
PORT=3000
NODE_ENV=production
DAILY_LLM_BUDGET_USD=
NARRATE_MODEL=claude-sonnet-5
COMPOSE_MODEL=claude-fable-5
AGENT_MODEL=               # the model the build agent AUTHORS with (default: sonnet)
SEED_ORG_ID=

# ── Preview proxy: kills Daytona's "Preview URL Warning" interstitial ────────
# A wildcard subdomain (e.g. preview.tryselvedge.com with *.preview… pointed at
# this service). When set, workshop previews are served from
# https://<slug>.<PREVIEW_DOMAIN>/ and the server injects the skip-warning
# header upstream. Unset → direct signed Daytona URLs, warning included.
PREVIEW_DOMAIN=
